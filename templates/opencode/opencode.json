{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "sigmora": {
        "type": "remote",
        "url": "https://api.sigmora.org/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:SIGMORA_API_KEY}"
        },
        "enabled": true
      }
    }
  }
}
